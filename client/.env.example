# URL de tu backend en la nube (Render / Railway / Hugging Face Spaces) para TikTok, SoundCloud e Instagram.
# En desarrollo local puedes dejarlo vacío (Vite hace proxy a http://localhost:3001).
VITE_API_URL=

# Opcional: URL del motor local en PC para YouTube y Spotify (por defecto http://127.0.0.1:3001)
# VITE_LOCAL_API_URL=http://127.0.0.1:3001

# Claves de tu proyecto Firebase (Auth con Google + Cloud Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
