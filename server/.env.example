PORT=3001
# Opcional: para desbloquear Instagram si pide inicio de sesión / rate-limit
# Opción 1 (local o nube): coloca un archivo cookies.txt en server/cookies.txt o pon aquí su ruta
# YTDLP_COOKIES_FILE=./cookies.txt
# Opción 2 (solo en tu PC local): usa las cookies de tu navegador (chrome, edge, firefox, brave)
# YTDLP_COOKIES_BROWSER=chrome
