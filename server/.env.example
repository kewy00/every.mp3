PORT=3001

# Opcional: cookies para desbloquear YouTube en servidores en la nube (Render/Railway) o Instagram
# Opción 1 (Recomendada en Render / Railway): cookies.txt codificado en Base64
#   base64 -w 0 cookies.txt   (Linux)  |  base64 -i cookies.txt   (macOS)
# YTDLP_COOKIES_B64=

# Opción 2: contenido de cookies.txt directo en variable de entorno
# YTDLP_COOKIES=

# Opción 3 (local o volumen montado): ruta a cookies.txt (por defecto usa server/cookies.txt si existe)
# YTDLP_COOKIES_FILE=./cookies.txt

# Opción 4 (solo en tu PC local): usa las cookies de tu navegador (chrome, edge, firefox, brave)
# YTDLP_COOKIES_BROWSER=chrome

# Opcional: proxy HTTP/HTTPS/SOCKS5 si YouTube bloquea la IP del centro de datos (Render/Railway)
# YTDLP_PROXY=http://usuario:password@host:puerto

# Opcional: forzar cliente(s) de YouTube (por defecto usa default con reintento automático)
# YTDLP_PLAYER_CLIENT=tv,mweb

# Opcional: forzar IPv4 (activo por defecto; pon false para permitir IPv6)
# YTDLP_FORCE_IPV4=true

# Opcional: auto-actualizar yt-dlp al arrancar el servidor (activo por defecto)
# YTDLP_AUTO_UPDATE=true
